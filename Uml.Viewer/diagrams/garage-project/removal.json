{
  "interactions": {
    "removal": {
      "story": "remove-vehicle",
      "participants": [
        "operator",
        "garage",
        "spot"
      ],
      "steps": [
        {
          "id": "request",
          "kind": "call",
          "from": "operator",
          "to": "garage",
          "label": "Remove(registrationNumber)",
          "references": [
            "garage.remove"
          ]
        },
        {
          "id": "lookup",
          "kind": "call",
          "from": "garage",
          "to": "garage",
          "label": "FindVehicleByRegistration(registrationNumber)",
          "references": [
            "garage.find"
          ]
        },
        {
          "id": "removal-result",
          "kind": "alt",
          "name": "Removal outcome",
          "branches": [
            {
              "guard": "Vehicle was found",
              "steps": [
                {
                  "id": "release",
                  "kind": "call",
                  "from": "garage",
                  "to": "spot",
                  "label": "Clear()",
                  "references": [
                    "spot.clear"
                  ]
                },
                {
                  "id": "removed",
                  "kind": "reply",
                  "from": "garage",
                  "to": "operator",
                  "label": "GarageOperationResult.Completed(spot)",
                  "references": [
                    "garage.remove"
                  ]
                }
              ]
            },
            {
              "guard": "Vehicle was not found",
              "steps": [
                {
                  "id": "missing",
                  "kind": "reply",
                  "from": "garage",
                  "to": "operator",
                  "label": "GarageOperationResult.Failed(VehicleNotFound)",
                  "references": [
                    "garage.remove"
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "activities": {
    "removal": {
      "nodes": [
        {
          "id": "start",
          "kind": "initial",
          "name": "Start"
        },
        {
          "id": "request",
          "kind": "action",
          "name": "Request removal",
          "references": [
            "garage.remove"
          ]
        },
        {
          "id": "lookup",
          "kind": "action",
          "name": "Find vehicle by registration",
          "references": [
            "garage.find"
          ]
        },
        {
          "id": "found",
          "kind": "decision",
          "name": "Vehicle found?",
          "references": [
            "garage.find"
          ]
        },
        {
          "id": "clear",
          "kind": "action",
          "name": "Clear the parking spot",
          "references": [
            "spot.clear"
          ]
        },
        {
          "id": "success",
          "kind": "action",
          "name": "Return removal success",
          "references": [
            "garage.remove"
          ]
        },
        {
          "id": "failure",
          "kind": "action",
          "name": "Return vehicle not found",
          "references": [
            "garage.remove"
          ]
        },
        {
          "id": "end",
          "kind": "final",
          "name": "Finish"
        }
      ],
      "flows": [
        {
          "id": "begin",
          "from": "start",
          "to": "request"
        },
        {
          "id": "find",
          "from": "request",
          "to": "lookup"
        },
        {
          "id": "check",
          "from": "lookup",
          "to": "found"
        },
        {
          "id": "yes",
          "from": "found",
          "to": "clear",
          "guard": "yes"
        },
        {
          "id": "no",
          "from": "found",
          "to": "failure",
          "guard": "no"
        },
        {
          "id": "report",
          "from": "clear",
          "to": "success"
        },
        {
          "id": "done",
          "from": "success",
          "to": "end"
        },
        {
          "id": "failed",
          "from": "failure",
          "to": "end"
        }
      ]
    }
  },
  "views": [
    {
      "id": "removal-sequence",
      "type": "sequence",
      "title": "Garage · removal conversation",
      "interaction": "removal"
    },
    {
      "id": "removal-communication",
      "type": "communication",
      "title": "Garage · removal collaborators",
      "interaction": "removal"
    },
    {
      "id": "removal-activity",
      "type": "activity",
      "title": "Garage · removal workflow",
      "activity": "removal"
    }
  ]
}
