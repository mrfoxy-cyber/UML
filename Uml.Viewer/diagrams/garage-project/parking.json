{
  "interactions": {
    "parking": {
      "story": "park-vehicle",
      "participants": [
        "operator",
        "service",
        "garage",
        "spot"
      ],
      "steps": [
        {
          "id": "request",
          "kind": "call",
          "from": "operator",
          "to": "service",
          "label": "Park(vehicle, garage)",
          "references": [
            "service.park"
          ],
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "validate",
          "kind": "call",
          "from": "service",
          "to": "service",
          "label": "ParkNewVehicle(vehicle, garage, null)",
          "references": [
            "service.parkNew"
          ],
          "tests": null
        },
        {
          "id": "already-parked",
          "kind": "call",
          "from": "service",
          "to": "service",
          "label": "IsParked(vehicle)",
          "references": [
            "service.isParked"
          ],
          "tests": null
        },
        {
          "id": "parking-result",
          "kind": "alt",
          "name": "Parking outcome",
          "display": {
            "initial": "collapsed",
            "collapsed": {
              "name": "Parking result · open paths",
              "show": [
                "name",
                "count"
              ]
            },
            "expanded": {
              "name": "Parking result · success or failure",
              "show": [
                "name",
                "steps"
              ]
            }
          },
          "branches": [
            {
              "guard": "Catalog vehicle, registered garage and vehicle not already parked",
              "steps": [
                {
                  "id": "auto-park",
                  "kind": "call",
                  "from": "service",
                  "to": "garage",
                  "label": "Park(vehicle)",
                  "references": [
                    "garage.park"
                  ],
                  "tests": [
                    "garage.park-success",
                    "garage.park-full"
                  ]
                },
                {
                  "id": "fit-check",
                  "kind": "call",
                  "from": "garage",
                  "to": "spot",
                  "label": "Fits(vehicle) during spot selection",
                  "references": [
                    "spot.fits"
                  ],
                  "tests": null
                },
                {
                  "id": "numbered-park",
                  "kind": "call",
                  "from": "garage",
                  "to": "garage",
                  "label": "Park(vehicle, availableSpot.Number)",
                  "references": [
                    "garage.parkAt"
                  ],
                  "tests": [
                    "garage.park-requested"
                  ]
                },
                {
                  "id": "recheck-fit",
                  "kind": "call",
                  "from": "garage",
                  "to": "spot",
                  "label": "Fits(vehicle) during numbered parking",
                  "references": [
                    "spot.fits"
                  ],
                  "tests": null
                },
                {
                  "id": "assign",
                  "kind": "call",
                  "from": "garage",
                  "to": "spot",
                  "label": "Park(vehicle)",
                  "references": [
                    "spot.park"
                  ],
                  "tests": null
                },
                {
                  "id": "success",
                  "kind": "reply",
                  "from": "garage",
                  "to": "service",
                  "label": "ParkingResult.Completed(spot)",
                  "references": [
                    "garage.parkAt"
                  ],
                  "tests": [
                    "garage.park-requested"
                  ]
                },
                {
                  "id": "accepted",
                  "kind": "reply",
                  "from": "service",
                  "to": "operator",
                  "label": "ParkingResult: parked",
                  "references": [
                    "service.park"
                  ],
                  "tests": [
                    "garage.move-workflow",
                    "garage.reject-external"
                  ]
                }
              ]
            },
            {
              "guard": "Validation fails or no empty fitting spot is available",
              "steps": [
                {
                  "id": "rejected",
                  "kind": "reply",
                  "from": "service",
                  "to": "operator",
                  "label": "ParkingResult.Failed(error)",
                  "references": [
                    "service.park"
                  ],
                  "tests": [
                    "garage.move-workflow",
                    "garage.reject-external"
                  ]
                }
              ]
            }
          ]
        }
      ],
      "tests": [
        "garage.move-workflow",
        "garage.park-success",
        "garage.park-full"
      ]
    }
  },
  "activities": {
    "parking": {
      "nodes": [
        {
          "id": "start",
          "kind": "initial",
          "name": "Start",
          "tests": null
        },
        {
          "id": "request",
          "kind": "action",
          "name": "Request parking",
          "references": [
            "service.park"
          ],
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "validate",
          "kind": "decision",
          "name": "Vehicle and garage valid?",
          "references": [
            "service.park",
            "service.parkNew",
            "service.isParked"
          ],
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "select",
          "kind": "action",
          "name": "Find an empty fitting spot",
          "references": [
            "garage.park",
            "spot.fits"
          ],
          "tests": [
            "garage.park-success",
            "garage.park-full"
          ]
        },
        {
          "id": "available",
          "kind": "decision",
          "name": "Fitting spot found?",
          "references": [
            "garage.park"
          ],
          "tests": [
            "garage.park-success",
            "garage.park-full"
          ]
        },
        {
          "id": "numbered",
          "kind": "action",
          "name": "Park at selected spot",
          "references": [
            "garage.parkAt"
          ],
          "tests": [
            "garage.park-requested"
          ]
        },
        {
          "id": "assign",
          "kind": "action",
          "name": "Assign vehicle to spot",
          "references": [
            "spot.park"
          ],
          "tests": null
        },
        {
          "id": "success",
          "kind": "action",
          "name": "Return parking success",
          "references": [
            "service.park"
          ],
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "failure",
          "kind": "action",
          "name": "Return parking failure",
          "references": [
            "service.park"
          ],
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "end",
          "kind": "final",
          "name": "Finish",
          "tests": null
        }
      ],
      "flows": [
        {
          "id": "begin",
          "from": "start",
          "to": "request",
          "tests": null
        },
        {
          "id": "check",
          "from": "request",
          "to": "validate",
          "tests": null
        },
        {
          "id": "valid",
          "from": "validate",
          "to": "select",
          "guard": "yes",
          "tests": null
        },
        {
          "id": "invalid",
          "from": "validate",
          "to": "failure",
          "guard": "no",
          "tests": null
        },
        {
          "id": "selected",
          "from": "select",
          "to": "available",
          "tests": null
        },
        {
          "id": "found",
          "from": "available",
          "to": "numbered",
          "guard": "yes",
          "tests": null
        },
        {
          "id": "full",
          "from": "available",
          "to": "failure",
          "guard": "no",
          "tests": [
            "garage.park-full"
          ]
        },
        {
          "id": "park",
          "from": "numbered",
          "to": "assign",
          "tests": null
        },
        {
          "id": "report",
          "from": "assign",
          "to": "success",
          "tests": null
        },
        {
          "id": "done",
          "from": "success",
          "to": "end",
          "tests": null
        },
        {
          "id": "failed",
          "from": "failure",
          "to": "end",
          "tests": null
        }
      ],
      "tests": [
        "garage.move-workflow",
        "garage.park-success",
        "garage.park-full"
      ]
    }
  },
  "views": [
    {
      "id": "parking-sequence",
      "type": "sequence",
      "title": "Garage · parking conversation",
      "interaction": "parking",
      "tests": null
    },
    {
      "id": "parking-communication",
      "type": "communication",
      "title": "Garage · parking collaborators",
      "interaction": "parking",
      "tests": null
    },
    {
      "id": "parking-activity",
      "type": "activity",
      "title": "Garage · parking workflow",
      "activity": "parking",
      "tests": null
    }
  ]
}
