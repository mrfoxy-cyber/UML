{
  "elements": {
    "operator": {
      "kind": "actor",
      "name": "Garage operator"
    },
    "service": {
      "kind": "class",
      "name": "GarageService",
      "notes": "Reviewed against Garage/Services/GarageService.cs. Calls are simplified; collection queries and exception handling are omitted.",
      "members": [
        {
          "id": "service.park",
          "kind": "operation",
          "name": "+ Park(vehicle, garage, spotNumber?)"
        },
        {
          "id": "service.parkNew",
          "kind": "operation",
          "name": "- ParkNewVehicle(vehicle, garage, spotNumber?)"
        },
        {
          "id": "service.isParked",
          "kind": "operation",
          "name": "+ IsParked(vehicle)"
        }
      ],
      "display": {
        "collapsed": {
          "name": "Garage service",
          "show": [
            "name",
            "kind",
            "count"
          ]
        },
        "expanded": {
          "name": "GarageService · operations",
          "show": [
            "name",
            "kind",
            "members",
            "notes"
          ]
        }
      }
    },
    "garage": {
      "kind": "class",
      "name": "Garage",
      "notes": "Garage/Models/Garage.cs. Automatic parking chooses an empty fitting spot, then delegates to the numbered overload.",
      "members": [
        {
          "id": "garage.park",
          "kind": "operation",
          "name": "+ Park(vehicle)"
        },
        {
          "id": "garage.parkAt",
          "kind": "operation",
          "name": "+ Park(vehicle, spot)"
        },
        {
          "id": "garage.remove",
          "kind": "operation",
          "name": "+ Remove(registrationNumber)"
        },
        {
          "id": "garage.find",
          "kind": "operation",
          "name": "+ FindVehicleByRegistration(registrationNumber)"
        }
      ]
    },
    "spot": {
      "kind": "class",
      "name": "ParkingSpot",
      "notes": "Garage/Models/ParkingSpot.cs. Internal implementation class. Park verifies the spot again before setting Vehicle.",
      "members": [
        {
          "id": "spot.fits",
          "kind": "operation",
          "name": "+ Fits(vehicle)"
        },
        {
          "id": "spot.park",
          "kind": "operation",
          "name": "+ Park(vehicle)"
        },
        {
          "id": "spot.clear",
          "kind": "operation",
          "name": "+ Clear()"
        }
      ]
    },
    "vehicle": {
      "kind": "class",
      "name": "Vehicle",
      "members": [
        "RegistrationNumber",
        "SpecificationDetails"
      ]
    }
  },
  "groups": [
    {
      "id": "domain",
      "name": "Garage internals",
      "members": [
        "garage",
        "spot",
        "vehicle"
      ],
      "display": {
        "initial": "collapsed",
        "collapsed": {
          "name": "Garage domain · reveal classes",
          "show": [
            "name",
            "count"
          ]
        },
        "expanded": {
          "name": "Garage domain",
          "show": [
            "name",
            "members"
          ]
        }
      }
    }
  ],
  "relationships": [
    {
      "id": "service-uses-garage",
      "kind": "dependency",
      "from": "service",
      "to": "garage"
    },
    {
      "id": "garage-owns-spots",
      "kind": "composition",
      "from": "garage",
      "to": "spot",
      "toMultiplicity": "1..*"
    },
    {
      "id": "spot-holds-vehicle",
      "kind": "association",
      "from": "spot",
      "to": "vehicle",
      "toMultiplicity": "0..1"
    }
  ]
}
