          "name": "+ Remove(registrationNumber)",
          "tests": [
            "garage.remove-success",
            "garage.remove-missing"
          ]
        },
        {
          "id": "garage.find",
          "kind": "operation",
          "name": "+ FindVehicleByRegistration(registrationNumber)",
          "tests": [
            "garage.find-case"
          ]
        }
      ],
      "tests": [
        "garage.parking-suite",
        "garage.removal-suite"
      ]
