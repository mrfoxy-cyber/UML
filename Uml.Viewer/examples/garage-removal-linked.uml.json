{
  "$schema": "../schema/uml-document.schema.json",
  "version": 1,
  "id": "garage-removal-linked",
  "title": "Garage · removal linked example",
  "elements": {
    "operator": {
      "kind": "actor",
      "name": "Garage operator",
      "tests": null
    },
    "service": {
      "kind": "class",
      "name": "GarageService",
      "notes": "Reviewed against Garage/Services/GarageService.cs. Calls are simplified; collection queries and exception handling are omitted.",
      "members": [
        {
          "id": "service.park",
          "kind": "operation",
          "name": "+ Park(vehicle, garage, spotNumber?)",
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "service.parkNew",
          "kind": "operation",
          "name": "- ParkNewVehicle(vehicle, garage, spotNumber?)",
          "tests": null
        },
        {
          "id": "service.isParked",
          "kind": "operation",
          "name": "+ IsParked(vehicle)",
          "tests": null
        }
      ],
      "display": {
        "collapsed": {
          "name": "Garage service",
          "show": [
            "name",
            "kind",
            "count"
          ]
        },
        "expanded": {
          "name": "GarageService · operations",
          "show": [
            "name",
            "kind",
            "members",
            "notes"
          ]
        }
      },
      "tests": [
        "garage.service-suite"
      ]
    },
    "garage": {
      "kind": "class",
      "name": "Garage",
      "notes": "Garage/Models/Garage.cs. Automatic parking chooses an empty fitting spot, then delegates to the numbered overload.",
      "members": [
        {
          "id": "garage.park",
          "kind": "operation",
          "name": "+ Park(vehicle)",
          "tests": [
            "garage.park-success",
            "garage.park-full"
          ]
        },
        {
          "id": "garage.parkAt",
          "kind": "operation",
          "name": "+ Park(vehicle, spot)",
          "tests": [
            "garage.park-requested"
          ]
        },
        {
          "id": "garage.remove",
          "kind": "operation",
          "name": "+ Remove(registrationNumber)",
          "tests": [
            "garage.remove-success",
            "garage.remove-missing"
          ]
        },
        {
          "id": "garage.find",
          "kind": "operation",
          "name": "+ FindVehicleByRegistration(registrationNumber)",
          "tests": [
            "garage.find-case"
          ]
        }
      ],
      "tests": [
        "garage.parking-suite",
        "garage.removal-suite"
      ]
    },
    "spot": {
      "kind": "class",
      "name": "ParkingSpot",
      "notes": "Garage/Models/ParkingSpot.cs. Internal implementation class. Park verifies the spot again before setting Vehicle.",
      "members": [
        {
          "id": "spot.fits",
          "kind": "operation",
          "name": "+ Fits(vehicle)",
          "tests": null
        },
        {
          "id": "spot.park",
          "kind": "operation",
          "name": "+ Park(vehicle)",
          "tests": null
        },
        {
          "id": "spot.clear",
          "kind": "operation",
          "name": "+ Clear()",
          "tests": null
        }
      ],
      "tests": null
    },
    "vehicle": {
      "kind": "class",
      "name": "Vehicle",
      "members": [
        "RegistrationNumber",
        "SpecificationDetails"
      ],
      "tests": null
    }
  },
  "groups": [
    {
      "id": "domain",
      "name": "Garage internals",
      "members": [
        "garage",
        "spot",
        "vehicle"
      ],
      "display": {
        "initial": "collapsed",
        "collapsed": {
          "name": "Garage domain · reveal classes",
          "show": [
            "name",
            "count"
          ]
        },
        "expanded": {
          "name": "Garage domain",
          "show": [
            "name",
            "members"
          ]
        }
      }
    }
  ],
  "relationships": [
    {
      "id": "service-uses-garage",
      "kind": "dependency",
      "from": "service",
      "to": "garage"
    },
    {
      "id": "garage-owns-spots",
      "kind": "composition",
      "from": "garage",
      "to": "spot",
      "toMultiplicity": "1..*"
    },
    {
      "id": "spot-holds-vehicle",
      "kind": "association",
      "from": "spot",
      "to": "vehicle",
      "toMultiplicity": "0..1"
    }
  ],
  "interactions": {
    "removal": {
      "story": "remove-vehicle",
      "participants": [
        "operator",
        "garage",
        "spot"
      ],
      "steps": [
        {
          "id": "request",
          "kind": "call",
          "from": "operator",
          "to": "garage",
          "label": "Remove(registrationNumber)",
          "references": [
            "garage.remove"
          ],
          "tests": [
            "garage.remove-success",
            "garage.remove-missing"
          ]
        },
        {
          "id": "lookup",
          "kind": "call",
          "from": "garage",
          "to": "garage",
          "label": "FindVehicleByRegistration(registrationNumber)",
          "references": [
            "garage.find"
          ],
          "tests": [
            "garage.find-case"
          ]
        },
        {
          "id": "removal-result",
          "kind": "alt",
          "name": "Removal outcome",
          "branches": [
            {
              "guard": "Vehicle was found",
              "steps": [
                {
                  "id": "release",
                  "kind": "call",
                  "from": "garage",
                  "to": "spot",
                  "label": "Clear()",
                  "references": [
                    "spot.clear"
                  ],
                  "tests": null
                },
                {
                  "id": "removed",
                  "kind": "reply",
                  "from": "garage",
                  "to": "operator",
                  "label": "GarageOperationResult.Completed(spot)",
                  "references": [
                    "garage.remove"
                  ],
                  "tests": [
                    "garage.remove-success",
                    "garage.remove-missing"
                  ]
                }
              ]
            },
            {
              "guard": "Vehicle was not found",
              "steps": [
                {
                  "id": "missing",
                  "kind": "reply",
                  "from": "garage",
                  "to": "operator",
                  "label": "GarageOperationResult.Failed(VehicleNotFound)",
                  "references": [
                    "garage.remove"
                  ],
                  "tests": [
                    "garage.remove-success",
                    "garage.remove-missing"
                  ]
                }
              ]
            }
          ]
        }
      ],
      "tests": [
        "garage.remove-success",
        "garage.remove-missing"
      ]
    }
  },
  "activities": {
    "removal": {
      "nodes": [
        {
          "id": "start",
          "kind": "initial",
          "name": "Start",
          "tests": null
        },
        {
          "id": "request",
          "kind": "action",
          "name": "Request removal",
          "references": [
            "garage.remove"
          ],
          "tests": [
            "garage.remove-success",
            "garage.remove-missing"
          ]
        },
        {
          "id": "lookup",
          "kind": "action",
          "name": "Find vehicle by registration",
          "references": [
            "garage.find"
          ],
          "tests": [
            "garage.find-case"
          ]
        },
        {
          "id": "found",
          "kind": "decision",
          "name": "Vehicle found?",
          "references": [
            "garage.find"
          ],
          "tests": [
            "garage.find-case"
          ]
        },
        {
          "id": "clear",
          "kind": "action",
          "name": "Clear the parking spot",
          "references": [
            "spot.clear"
          ],
          "tests": null
        },
        {
          "id": "success",
          "kind": "action",
          "name": "Return removal success",
          "references": [
            "garage.remove"
          ],
          "tests": [
            "garage.remove-success",
            "garage.remove-missing"
          ]
        },
        {
          "id": "failure",
          "kind": "action",
          "name": "Return vehicle not found",
          "references": [
            "garage.remove"
          ],
          "tests": [
            "garage.remove-success",
            "garage.remove-missing"
          ]
        },
        {
          "id": "end",
          "kind": "final",
          "name": "Finish",
          "tests": null
        }
      ],
      "flows": [
        {
          "id": "begin",
          "from": "start",
          "to": "request",
          "tests": null
        },
        {
          "id": "find",
          "from": "request",
          "to": "lookup",
          "tests": null
        },
        {
          "id": "check",
          "from": "lookup",
          "to": "found",
          "tests": null
        },
        {
          "id": "yes",
          "from": "found",
          "to": "clear",
          "guard": "yes",
          "tests": null
        },
        {
          "id": "no",
          "from": "found",
          "to": "failure",
          "guard": "no",
          "tests": null
        },
        {
          "id": "report",
          "from": "clear",
          "to": "success",
          "tests": null
        },
        {
          "id": "done",
          "from": "success",
          "to": "end",
          "tests": null
        },
        {
          "id": "failed",
          "from": "failure",
          "to": "end",
          "tests": null
        }
      ],
      "tests": [
        "garage.remove-success",
        "garage.remove-missing"
      ]
    }
  },
  "views": [
    {
      "id": "model",
      "type": "class",
      "title": "Garage · shared model",
      "elements": [
        "service",
        "garage",
        "spot",
        "vehicle"
      ],
      "tests": [
        "garage.parking-suite",
        "garage.removal-suite"
      ]
    },
    {
      "id": "removal-sequence",
      "type": "sequence",
      "title": "Garage · removal conversation",
      "interaction": "removal",
      "tests": null
    },
    {
      "id": "removal-communication",
      "type": "communication",
      "title": "Garage · removal collaborators",
      "interaction": "removal",
      "tests": null
    },
    {
      "id": "removal-activity",
      "type": "activity",
      "title": "Garage · removal workflow",
      "activity": "removal",
      "tests": null
    }
  ],
  "tests": {
    "garage.parking-suite": {
      "name": "Garage parking tests",
      "kind": "suite",
      "file": "Garage.Tests/GarageParkingTests.cs",
      "symbol": "Garage.Tests.GarageParkingTests",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageParkingTests.cs"
    },
    "garage.removal-suite": {
      "name": "Garage removal tests",
      "kind": "suite",
      "file": "Garage.Tests/GarageRemovalTests.cs",
      "symbol": "Garage.Tests.GarageRemovalTests",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageRemovalTests.cs"
    },
    "garage.service-suite": {
      "name": "Garage service tests",
      "kind": "suite",
      "file": "Garage.Tests/GarageServiceTests.cs",
      "symbol": "Garage.Tests.GarageServiceTests",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageServiceTests.cs"
    },
    "garage.park-success": {
      "name": "Parking updates vehicle and space counts",
      "kind": "unit",
      "file": "Garage.Tests/GarageParkingTests.cs",
      "symbol": "Garage.Tests.GarageParkingTests.Park_AddsVehicleAndUpdatesSpaceCounts",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageParkingTests.cs"
    },
    "garage.park-full": {
      "name": "Parking fails when the garage is full",
      "kind": "unit",
      "file": "Garage.Tests/GarageParkingTests.cs",
      "symbol": "Garage.Tests.GarageParkingTests.Park_FailsWhenGarageIsFull",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageParkingTests.cs"
    },
    "garage.park-requested": {
      "name": "Parking uses the requested spot",
      "kind": "unit",
      "file": "Garage.Tests/GarageParkingTests.cs",
      "symbol": "Garage.Tests.GarageParkingTests.ParkAtSpot_UsesRequestedSpot",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageParkingTests.cs"
    },
    "garage.remove-success": {
      "name": "Removing a vehicle frees space",
      "kind": "unit",
      "file": "Garage.Tests/GarageRemovalTests.cs",
      "symbol": "Garage.Tests.GarageRemovalTests.Remove_RemovesVehicleAndFreesSpace",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageRemovalTests.cs"
    },
    "garage.remove-missing": {
      "name": "Removing an unknown registration fails",
      "kind": "unit",
      "file": "Garage.Tests/GarageRemovalTests.cs",
      "symbol": "Garage.Tests.GarageRemovalTests.Remove_ReturnsFailureForUnknownRegistration",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageRemovalTests.cs"
    },
    "garage.find-case": {
      "name": "Registration lookup ignores case",
      "kind": "unit",
      "file": "Garage.Tests/GarageRemovalTests.cs",
      "symbol": "Garage.Tests.GarageRemovalTests.FindVehicleByRegistration_IgnoresCase",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageRemovalTests.cs"
    },
    "garage.move-workflow": {
      "name": "Remove before parking in another garage",
      "kind": "workflow",
      "file": "Garage.Tests/GarageServiceWorkflowTests.cs",
      "symbol": "Garage.Tests.GarageServiceWorkflowTests.Park_VehicleMustBeRemovedBeforeParkingInAnotherGarage",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageServiceWorkflowTests.cs"
    },
    "garage.reject-external": {
      "name": "Parking rejects vehicles outside the catalogue",
      "kind": "unit",
      "file": "Garage.Tests/GarageServiceWorkflowTests.cs",
      "symbol": "Garage.Tests.GarageServiceWorkflowTests.Park_RejectsVehicleOutsideTheCatalog",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageServiceWorkflowTests.cs"
    }
  }
}
