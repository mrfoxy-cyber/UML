{
  "$schema": "../schema/uml-document.schema.json",
  "version": 1,
  "id": "garage-parking-linked",
  "title": "Garage · parking linked example",
  "elements": {
    "operator": {
      "kind": "actor",
      "name": "Garage operator",
      "tests": null
    },
    "service": {
      "kind": "class",
      "name": "GarageService",
      "notes": "Reviewed against Garage/Services/GarageService.cs. Calls are simplified; collection queries and exception handling are omitted.",
      "members": [
        {
          "id": "service.park",
          "kind": "operation",
          "name": "+ Park(vehicle, garage, spotNumber?)",
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "service.parkNew",
          "kind": "operation",
          "name": "- ParkNewVehicle(vehicle, garage, spotNumber?)",
          "tests": null
        },
        {
          "id": "service.isParked",
          "kind": "operation",
          "name": "+ IsParked(vehicle)",
          "tests": null
        }
      ],
      "display": {
        "collapsed": {
          "name": "Garage service",
          "show": [
            "name",
            "kind",
            "count"
          ]
        },
        "expanded": {
          "name": "GarageService · operations",
          "show": [
            "name",
            "kind",
            "members",
            "notes"
          ]
        }
      },
      "tests": [
        "garage.service-suite"
      ]
    },
    "garage": {
      "kind": "class",
      "name": "Garage",
      "notes": "Garage/Models/Garage.cs. Automatic parking chooses an empty fitting spot, then delegates to the numbered overload.",
      "members": [
        {
          "id": "garage.park",
          "kind": "operation",
          "name": "+ Park(vehicle)",
          "tests": [
            "garage.park-success",
            "garage.park-full"
          ]
        },
        {
          "id": "garage.parkAt",
          "kind": "operation",
          "name": "+ Park(vehicle, spot)",
          "tests": [
            "garage.park-requested"
          ]
        },
        {
          "id": "garage.remove",
          "kind": "operation",
          "name": "+ Remove(registrationNumber)",
          "tests": [
            "garage.remove-success",
            "garage.remove-missing"
          ]
        },
        {
          "id": "garage.find",
          "kind": "operation",
          "name": "+ FindVehicleByRegistration(registrationNumber)",
          "tests": [
            "garage.find-case"
          ]
        }
      ],
      "tests": [
        "garage.parking-suite",
        "garage.removal-suite"
      ]
    },
    "spot": {
      "kind": "class",
      "name": "ParkingSpot",
      "notes": "Garage/Models/ParkingSpot.cs. Internal implementation class. Park verifies the spot again before setting Vehicle.",
      "members": [
        {
          "id": "spot.fits",
          "kind": "operation",
          "name": "+ Fits(vehicle)",
          "tests": null
        },
        {
          "id": "spot.park",
          "kind": "operation",
          "name": "+ Park(vehicle)",
          "tests": null
        },
        {
          "id": "spot.clear",
          "kind": "operation",
          "name": "+ Clear()",
          "tests": null
        }
      ],
      "tests": null
    },
    "vehicle": {
      "kind": "class",
      "name": "Vehicle",
      "members": [
        "RegistrationNumber",
        "SpecificationDetails"
      ],
      "tests": null
    }
  },
  "groups": [
    {
      "id": "domain",
      "name": "Garage internals",
      "members": [
        "garage",
        "spot",
        "vehicle"
      ],
      "display": {
        "initial": "collapsed",
        "collapsed": {
          "name": "Garage domain · reveal classes",
          "show": [
            "name",
            "count"
          ]
        },
        "expanded": {
          "name": "Garage domain",
          "show": [
            "name",
            "members"
          ]
        }
      }
    }
  ],
  "relationships": [
    {
      "id": "service-uses-garage",
      "kind": "dependency",
      "from": "service",
      "to": "garage"
    },
    {
      "id": "garage-owns-spots",
      "kind": "composition",
      "from": "garage",
      "to": "spot",
      "toMultiplicity": "1..*"
    },
    {
      "id": "spot-holds-vehicle",
      "kind": "association",
      "from": "spot",
      "to": "vehicle",
      "toMultiplicity": "0..1"
    }
  ],
  "interactions": {
    "parking": {
      "story": "park-vehicle",
      "participants": [
        "operator",
        "service",
        "garage",
        "spot"
      ],
      "steps": [
        {
          "id": "request",
          "kind": "call",
          "from": "operator",
          "to": "service",
          "label": "Park(vehicle, garage)",
          "references": [
            "service.park"
          ],
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "validate",
          "kind": "call",
          "from": "service",
          "to": "service",
          "label": "ParkNewVehicle(vehicle, garage, null)",
          "references": [
            "service.parkNew"
          ],
          "tests": null
        },
        {
          "id": "already-parked",
          "kind": "call",
          "from": "service",
          "to": "service",
          "label": "IsParked(vehicle)",
          "references": [
            "service.isParked"
          ],
          "tests": null
        },
        {
          "id": "parking-result",
          "kind": "alt",
          "name": "Parking outcome",
          "display": {
            "initial": "collapsed",
            "collapsed": {
              "name": "Parking result · open paths",
              "show": [
                "name",
                "count"
              ]
            },
            "expanded": {
              "name": "Parking result · success or failure",
              "show": [
                "name",
                "steps"
              ]
            }
          },
          "branches": [
            {
              "guard": "Catalog vehicle, registered garage and vehicle not already parked",
              "steps": [
                {
                  "id": "auto-park",
                  "kind": "call",
                  "from": "service",
                  "to": "garage",
                  "label": "Park(vehicle)",
                  "references": [
                    "garage.park"
                  ],
                  "tests": [
                    "garage.park-success",
                    "garage.park-full"
                  ]
                },
                {
                  "id": "fit-check",
                  "kind": "call",
                  "from": "garage",
                  "to": "spot",
                  "label": "Fits(vehicle) during spot selection",
                  "references": [
                    "spot.fits"
                  ],
                  "tests": null
                },
                {
                  "id": "numbered-park",
                  "kind": "call",
                  "from": "garage",
                  "to": "garage",
                  "label": "Park(vehicle, availableSpot.Number)",
                  "references": [
                    "garage.parkAt"
                  ],
                  "tests": [
                    "garage.park-requested"
                  ]
                },
                {
                  "id": "recheck-fit",
                  "kind": "call",
                  "from": "garage",
                  "to": "spot",
                  "label": "Fits(vehicle) during numbered parking",
                  "references": [
                    "spot.fits"
                  ],
                  "tests": null
                },
                {
                  "id": "assign",
                  "kind": "call",
                  "from": "garage",
                  "to": "spot",
                  "label": "Park(vehicle)",
                  "references": [
                    "spot.park"
                  ],
                  "tests": null
                },
                {
                  "id": "success",
                  "kind": "reply",
                  "from": "garage",
                  "to": "service",
                  "label": "ParkingResult.Completed(spot)",
                  "references": [
                    "garage.parkAt"
                  ],
                  "tests": [
                    "garage.park-requested"
                  ]
                },
                {
                  "id": "accepted",
                  "kind": "reply",
                  "from": "service",
                  "to": "operator",
                  "label": "ParkingResult: parked",
                  "references": [
                    "service.park"
                  ],
                  "tests": [
                    "garage.move-workflow",
                    "garage.reject-external"
                  ]
                }
              ]
            },
            {
              "guard": "Validation fails or no empty fitting spot is available",
              "steps": [
                {
                  "id": "rejected",
                  "kind": "reply",
                  "from": "service",
                  "to": "operator",
                  "label": "ParkingResult.Failed(error)",
                  "references": [
                    "service.park"
                  ],
                  "tests": [
                    "garage.move-workflow",
                    "garage.reject-external"
                  ]
                }
              ]
            }
          ]
        }
      ],
      "tests": [
        "garage.move-workflow",
        "garage.park-success",
        "garage.park-full"
      ]
    }
  },
  "activities": {
    "parking": {
      "nodes": [
        {
          "id": "start",
          "kind": "initial",
          "name": "Start",
          "tests": null
        },
        {
          "id": "request",
          "kind": "action",
          "name": "Request parking",
          "references": [
            "service.park"
          ],
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "validate",
          "kind": "decision",
          "name": "Vehicle and garage valid?",
          "references": [
            "service.park",
            "service.parkNew",
            "service.isParked"
          ],
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "select",
          "kind": "action",
          "name": "Find an empty fitting spot",
          "references": [
            "garage.park",
            "spot.fits"
          ],
          "tests": [
            "garage.park-success",
            "garage.park-full"
          ]
        },
        {
          "id": "available",
          "kind": "decision",
          "name": "Fitting spot found?",
          "references": [
            "garage.park"
          ],
          "tests": [
            "garage.park-success",
            "garage.park-full"
          ]
        },
        {
          "id": "numbered",
          "kind": "action",
          "name": "Park at selected spot",
          "references": [
            "garage.parkAt"
          ],
          "tests": [
            "garage.park-requested"
          ]
        },
        {
          "id": "assign",
          "kind": "action",
          "name": "Assign vehicle to spot",
          "references": [
            "spot.park"
          ],
          "tests": null
        },
        {
          "id": "success",
          "kind": "action",
          "name": "Return parking success",
          "references": [
            "service.park"
          ],
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "failure",
          "kind": "action",
          "name": "Return parking failure",
          "references": [
            "service.park"
          ],
          "tests": [
            "garage.move-workflow",
            "garage.reject-external"
          ]
        },
        {
          "id": "end",
          "kind": "final",
          "name": "Finish",
          "tests": null
        }
      ],
      "flows": [
        {
          "id": "begin",
          "from": "start",
          "to": "request",
          "tests": null
        },
        {
          "id": "check",
          "from": "request",
          "to": "validate",
          "tests": null
        },
        {
          "id": "valid",
          "from": "validate",
          "to": "select",
          "guard": "yes",
          "tests": null
        },
        {
          "id": "invalid",
          "from": "validate",
          "to": "failure",
          "guard": "no",
          "tests": null
        },
        {
          "id": "selected",
          "from": "select",
          "to": "available",
          "tests": null
        },
        {
          "id": "found",
          "from": "available",
          "to": "numbered",
          "guard": "yes",
          "tests": null
        },
        {
          "id": "full",
          "from": "available",
          "to": "failure",
          "guard": "no",
          "tests": [
            "garage.park-full"
          ]
        },
        {
          "id": "park",
          "from": "numbered",
          "to": "assign",
          "tests": null
        },
        {
          "id": "report",
          "from": "assign",
          "to": "success",
          "tests": null
        },
        {
          "id": "done",
          "from": "success",
          "to": "end",
          "tests": null
        },
        {
          "id": "failed",
          "from": "failure",
          "to": "end",
          "tests": null
        }
      ],
      "tests": [
        "garage.move-workflow",
        "garage.park-success",
        "garage.park-full"
      ]
    }
  },
  "views": [
    {
      "id": "model",
      "type": "class",
      "title": "Garage · shared model",
      "elements": [
        "service",
        "garage",
        "spot",
        "vehicle"
      ],
      "tests": [
        "garage.parking-suite",
        "garage.removal-suite"
      ]
    },
    {
      "id": "parking-sequence",
      "type": "sequence",
      "title": "Garage · parking conversation",
      "interaction": "parking",
      "tests": null
    },
    {
      "id": "parking-communication",
      "type": "communication",
      "title": "Garage · parking collaborators",
      "interaction": "parking",
      "tests": null
    },
    {
      "id": "parking-activity",
      "type": "activity",
      "title": "Garage · parking workflow",
      "activity": "parking",
      "tests": null
    }
  ],
  "tests": {
    "garage.parking-suite": {
      "name": "Garage parking tests",
      "kind": "suite",
      "file": "Garage.Tests/GarageParkingTests.cs",
      "symbol": "Garage.Tests.GarageParkingTests",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageParkingTests.cs"
    },
    "garage.removal-suite": {
      "name": "Garage removal tests",
      "kind": "suite",
      "file": "Garage.Tests/GarageRemovalTests.cs",
      "symbol": "Garage.Tests.GarageRemovalTests",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageRemovalTests.cs"
    },
    "garage.service-suite": {
      "name": "Garage service tests",
      "kind": "suite",
      "file": "Garage.Tests/GarageServiceTests.cs",
      "symbol": "Garage.Tests.GarageServiceTests",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageServiceTests.cs"
    },
    "garage.park-success": {
      "name": "Parking updates vehicle and space counts",
      "kind": "unit",
      "file": "Garage.Tests/GarageParkingTests.cs",
      "symbol": "Garage.Tests.GarageParkingTests.Park_AddsVehicleAndUpdatesSpaceCounts",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageParkingTests.cs"
    },
    "garage.park-full": {
      "name": "Parking fails when the garage is full",
      "kind": "unit",
      "file": "Garage.Tests/GarageParkingTests.cs",
      "symbol": "Garage.Tests.GarageParkingTests.Park_FailsWhenGarageIsFull",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageParkingTests.cs"
    },
    "garage.park-requested": {
      "name": "Parking uses the requested spot",
      "kind": "unit",
      "file": "Garage.Tests/GarageParkingTests.cs",
      "symbol": "Garage.Tests.GarageParkingTests.ParkAtSpot_UsesRequestedSpot",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageParkingTests.cs"
    },
    "garage.remove-success": {
      "name": "Removing a vehicle frees space",
      "kind": "unit",
      "file": "Garage.Tests/GarageRemovalTests.cs",
      "symbol": "Garage.Tests.GarageRemovalTests.Remove_RemovesVehicleAndFreesSpace",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageRemovalTests.cs"
    },
    "garage.remove-missing": {
      "name": "Removing an unknown registration fails",
      "kind": "unit",
      "file": "Garage.Tests/GarageRemovalTests.cs",
      "symbol": "Garage.Tests.GarageRemovalTests.Remove_ReturnsFailureForUnknownRegistration",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageRemovalTests.cs"
    },
    "garage.find-case": {
      "name": "Registration lookup ignores case",
      "kind": "unit",
      "file": "Garage.Tests/GarageRemovalTests.cs",
      "symbol": "Garage.Tests.GarageRemovalTests.FindVehicleByRegistration_IgnoresCase",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageRemovalTests.cs"
    },
    "garage.move-workflow": {
      "name": "Remove before parking in another garage",
      "kind": "workflow",
      "file": "Garage.Tests/GarageServiceWorkflowTests.cs",
      "symbol": "Garage.Tests.GarageServiceWorkflowTests.Park_VehicleMustBeRemovedBeforeParkingInAnotherGarage",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageServiceWorkflowTests.cs"
    },
    "garage.reject-external": {
      "name": "Parking rejects vehicles outside the catalogue",
      "kind": "unit",
      "file": "Garage.Tests/GarageServiceWorkflowTests.cs",
      "symbol": "Garage.Tests.GarageServiceWorkflowTests.Park_RejectsVehicleOutsideTheCatalog",
      "url": "https://github.com/mrfoxy-cyber/Garage-v2/blob/main/Garage.Tests/GarageServiceWorkflowTests.cs"
    }
  }
}
