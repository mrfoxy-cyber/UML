{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UML project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "id",
    "title",
    "model",
    "diagrams"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "const": 1
    },
    "kind": {
      "const": "uml-project"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 120
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  }
}
