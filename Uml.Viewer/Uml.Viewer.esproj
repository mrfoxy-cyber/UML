<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.7204101">
  <PropertyGroup>
    <StartupCommand>node scripts/serve.cjs</StartupCommand>
    <BuildCommand>node scripts/build.cjs</BuildCommand>
    <TestCommand>node --test tests/*.test.cjs</TestCommand>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>true</ShouldRunBuildScript>
    <DefaultItemExcludes>$(DefaultItemExcludes);.cache\**;test-results\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
